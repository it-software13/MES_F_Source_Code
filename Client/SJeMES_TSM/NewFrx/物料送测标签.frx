        <Column Name="ORG_ID" DataType="System.String"/>
        <Column Name="QTYSTR" DataType="System.String"/>
        <Column Name="PART_NO" DataType="System.String"/>
        <Column Name="TODAYDATE" DataType="System.String"/>
        <Column Name="SHOE_NAMEANDART_NO" DataType="System.String"/>
        <Column Name="ORDER_NOANDQTY" DataType="System.String"/>
      </TableDataSource>

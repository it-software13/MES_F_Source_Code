<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="08/27/2019 11:51:39" ReportInfo.Modified="02/16/2022 08:49:36" ReportInfo.CreatorVersion="2022.1.2.0">
  <Dictionary>
    <OdbcDataConnection Name="Connection" ConnectionString="" LoginPrompt="true">
      <TableDataSource Name="Table" DataType="System.Int32" Enabled="true" SelectCommand="SELECT DISTINCT m.CHK_NO AS 收料单号,&#13;&#10;                           '' as 收料单号和数量,&#13;&#10;                           '' as 收料数量,&#13;&#10;                           d.RCPT_QTY AS 收料数量2,&#13;&#10;                           to_char(SYSDATE, 'yyyy/MM/dd') AS 日期,&#13;&#10;                           b.SUPPLIERS_NAME AS 供应厂商名字,&#13;&#10;                           GF_ARTNO(m.source_no, i.order_seq) AS ArtNo,&#13;&#10;                           GF_Shoe_Name(GF_ARTNO(m.source_no, i.order_seq)) AS 鞋型,&#13;&#10;                           '' as ArtNo和鞋型,&#13;&#10;                           i.part_no AS 部位,&#13;&#10;                           e.name_t AS 材料名字,&#13;&#10;                           m.source_no AS 订单号,&#13;&#10;                           NVL(f.CHK_QTY, 0) AS 寄存数量,&#13;&#10;                           i.SALES_ORDER AS 销售订单号,&#13;&#10;                           '' AS 检验数量,&#13;&#10;                           NVL(f.CHK_QTY, 0) AS CHK_QTY,&#13;&#10;                           '' AS 抽检率,&#13;&#10;                           CASE&#13;&#10;                             WHEN (d.Rcpt_Qty &gt; 0) THEN&#13;&#10;                              round((NVL(f.CHK_QTY,0)/ d.Rcpt_Qty))&#13;&#10;                             ELSE&#13;&#10;                              0&#13;&#10;                           END AS 抽检率2,&#13;&#10;                           '' as 寄存日期,&#13;&#10;                           m.rcpt_date AS 寄存日期2,&#13;&#10;                           '' as 退货数量,&#13;&#10;                           NVL(i.RETURN_QTY, 0) AS 退货数量2,&#13;&#10;                           '' as 退货率,&#13;&#10;                           CASE&#13;&#10;                             WHEN (d.Rcpt_Qty &gt; 0) THEN&#13;&#10;                              round((NVL(i.RETURN_QTY, 0) / d.Rcpt_Qty),1)&#13;&#10;                             ELSE&#13;&#10;                              0&#13;&#10;                           END AS 退货率2,&#13;&#10;                           b.suppliers_code AS 供应厂商编号,&#13;&#10;                           i.item_no,&#13;&#10;                           m.stoc_no,&#13;&#10;                           d.item_no AS 材料号,&#13;&#10;                           m.org_id AS 工厂,&#13;&#10;                           '' AS Shoe_NameAndArt_No,&#13;&#10;                           '{unqualifiedCertificate}' AS 不合格证明&#13;&#10;                         FROM wms_rcpt_m m&#13;&#10;                        INNER JOIN wms_rcpt_d d&#13;&#10;                           ON m.chk_no = d.chk_no&#13;&#10;                        INNER JOIN bdm_purchase_order_item i&#13;&#10;                           ON d.source_no = i.order_no&#13;&#10;                          AND d.chk_seq = i.order_seq&#13;&#10;                        INNER JOIN base003m b&#13;&#10;                           ON b.SUPPLIERS_CODE = m.vend_no&#13;&#10;                        INNER JOIN bdm_rd_item e&#13;&#10;                           ON e.item_no = d.item_no&#13;&#10;                         LEFT JOIN iqc_chk_m f&#13;&#10;                           ON f.chk_no = d.chk_no&#13;&#10;                          AND f.chk_seq = d.chk_seq&#13;&#10;                          AND d.item_no = f.src_item_no&#13;&#10;                        WHERE 1 = 1 ">
        <Column Name="收料单号" DataType="System.String"/>
        <Column Name="收料数量" DataType="System.Decimal"/>
        <Column Name="日期" DataType="System.String"/>
        <Column Name="供应厂商名字" DataType="System.String"/>
        <Column Name="鞋型" DataType="System.String"/>
        <Column Name="部位" DataType="System.String"/>
        <Column Name="材料名字" DataType="System.String"/>
        <Column Name="订单号" DataType="System.String"/>
        <Column Name="寄存数量" DataType="System.Decimal"/>
        <Column Name="销售订单号" DataType="System.String"/>
        <Column Name="检验数量" DataType="System.Decimal"/>
        <Column Name="抽检率" DataType="System.Double"/>
        <Column Name="寄存日期" DataType="System.DateTime"/>
        <Column Name="退货数量" DataType="System.Decimal"/>
        <Column Name="退货率" DataType="System.Double"/>
        <Column Name="供应厂商编号" DataType="System.String"/>
        <Column Name="ITEM_NO" Enabled="false" DataType="System.String"/>
        <Column Name="STOC_NO" Enabled="false" DataType="System.String"/>
        <Column Name="工厂" DataType="System.String"/>
        <Column Name="SHOE_NAMEANDART_NO" Enabled="false" DataType="System.String"/>
        <Column Name="不合格证明" DataType="System.String"/>
        <Column Name="收料单号和数量" DataType="System.String"/>
        <Column Name="收料数量2" DataType="System.Decimal"/>
        <Column Name="CHK_QTY" DataType="System.Double"/>
        <Column Name="抽检率2" DataType="System.Double"/>
        <Column Name="寄存日期2" DataType="System.DateTime"/>
        <Column Name="退货数量2" DataType="System.Double"/>
        <Column Name="退货率2" DataType="System.Double"/>
        <Column Name="材料号" DataType="System.String"/>
        <Column Name="ARTNO" DataType="System.String"/>
        <Column Name="ARTNO和鞋型" DataType="System.String"/>
      </TableDataSource>
    </OdbcDataConnection>

  <Dictionary>
    <OdbcDataConnection Name="APEMES" ConnectionString="">
      <TableDataSource Name="Table" DataType="System.Int32" Enabled="true" SelectCommand="SELECT DISTINCT  b.suppliers_code,&#13;&#10;                 i.item_no,&#13;&#10;                 m.stoc_no,&#13;&#10;                 m.source_no AS ORDER_NO,&#13;&#10;                 GF_Shoe_Name(GF_ARTNO(m.source_no, i.order_seq)) AS Shoe_Name,&#13;&#10;                 GF_Art_Name(GF_ARTNO(m.source_no, i.order_seq)) AS Art_Name,&#13;&#10;                 GF_ARTNO(m.source_no, i.order_seq) AS ART_NO,&#13;&#10;                 GF_Ord_Qty(d.source_no, d.chk_seq) AS Ord_Qty,&#13;&#10;                 b.SUPPLIERS_NAME,&#13;&#10;                 d.item_no AS Material_No,&#13;&#10;                 e.name_t AS Material_Name,&#13;&#10;                 i.part_no,&#13;&#10;                 to_char(SYSDATE, 'yyyy/MM/dd') AS TodayDate,&#13;&#10;                 m.org_id,&#13;&#10;                 GF_Ord_Qty(d.source_no, d.chk_seq) AS QtyStr,&#13;&#10;                 '' AS Shoe_NameAndArt_No,&#13;&#10;                 '' AS ORDER_NOAndQty&#13;&#10;               FROM wms_rcpt_m m&#13;&#10;              INNER JOIN wms_rcpt_d d&#13;&#10;                 ON m.chk_no = d.chk_no&#13;&#10;              INNER JOIN bdm_purchase_order_item i&#13;&#10;                 ON d.source_no = i.order_no&#13;&#10;                AND d.chk_seq = i.order_seq&#13;&#10;              INNER JOIN base003m b&#13;&#10;                 ON b.SUPPLIERS_CODE = m.vend_no&#13;&#10;              INNER JOIN bdm_rd_item e&#13;&#10;                 ON e.item_no = d.item_no">
        <Column Name="SUPPLIERS_CODE" DataType="System.String"/>
        <Column Name="ITEM_NO" DataType="System.String"/>
        <Column Name="STOC_NO" DataType="System.String"/>
        <Column Name="ORDER_NO" DataType="System.String"/>
        <Column Name="SHOE_NAME" DataType="System.String"/>
        <Column Name="ART_NAME" DataType="System.String"/>
        <Column Name="ART_NO" DataType="System.String"/>
